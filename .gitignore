# Секреты и локальные настройки
.env

# Виртуальное окружение Python
.venv/
venv/

# Служебные файлы Python
__pycache__/
*.py[cod]

# Служебные папки Jupyter
.ipynb_checkpoints/

# Кэши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Настройки редактора, относящиеся к конкретному компьютеру
.vscode/

# Логи
*.log

# Метаданные установленных Python-пакетов
*.egg-info/

# Model artifacts
artifacts/current
artifacts/versions/*
!artifacts/versions/.gitkeep

# Исследовательские ноутбуки
notebooks/recsys.ipynb
notebooks/research.ipynb
